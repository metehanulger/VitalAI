
# PostgreSQL connection (SQLAlchemy URL, psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://triaj:triaj_sifre@localhost:5432/triajdb
# Apply Alembic migrations (schema + reference data) when the API starts
DB_AUTO_MIGRATE=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Departments the triage may recommend (comma-separated). Empty = default list.
POLIKLINIKLER=

LLM_PROVIDER=openai_compatible

LLM_API_KEY=

LLM_BASE_URL=https://api.openai.com/v1

LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_TRANSLATION_TIMEOUT_SECONDS=15

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=60

TRIAGE_URGENCY_MODEL=model_artifacts/urgency.joblib
TRIAGE_SPECIALTY_MODEL=model_artifacts/specialty.joblib

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
