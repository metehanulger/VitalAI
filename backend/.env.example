# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# .env git'e eklenmez (API anahtarları burada durur).

# Yerel geliştirme: SQLite. Docker Compose bu değeri DB2 adresiyle ezer.
# DB2 örneği: db2+ibm_db://db2inst1:sifre@localhost:50000/TRIAJDB
# (şifrede @ : / gibi karakterler varsa URL-encode edin)
DATABASE_URL=sqlite:///./triaj.db
DB_AUTO_CREATE=true

# Frontend adresleri (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# IBM watsonx.ai — boş bırakılırsa yalnızca kural tabanlı triaj çalışır
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
WATSONX_TIMEOUT=15
