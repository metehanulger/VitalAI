# =====================================================================
# VitialAI - Ön Triaj Servisi Ortam Değişkenleri (.env.example)
# Bu dosyayı kopyalayarak '.env' olarak kaydedin.
# =====================================================================

# ---------------------------------------------------------------------
# 1. VERİTABANI SEÇİMİ (EN HIZLI & EFEKTİF MİMARİ: POSTGRESQL)
# ---------------------------------------------------------------------
# PostgreSQL (Tavsiye edilen üretim ve ML veri tabanı):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triajdb

# Yerel hızlı test / internetsiz SQLite alternatifi:
# DATABASE_URL=sqlite:///./triaj.db

# IBM DB2 (Z Datathon Sunucusu İçin Alternatif):
DB2_DATABASE=TRIAGEDB
DB2_HOSTNAME=localhost
DB2_PORT=50000
DB2_PROTOCOL=TCPIP
DB2_UID=db2inst1
DB2_PWD=password123

# ---------------------------------------------------------------------
# 2. EVRENSEL LLM SEÇİMİ (İSTEDİĞİNİZ HERHANGİ BİR MODEL)
# ---------------------------------------------------------------------
# Seçenekler: openai_compatible | deepseek | groq | gemini | watsonx | ollama
LLM_PROVIDER=openai_compatible

# API Anahtarını buraya giriniz (Boş bırakılmıştır):
LLM_API_KEY=

# LLM Sağlayıcısının Base URL adresi:
# - OpenAI için:     https://api.openai.com/v1
# - DeepSeek için:   https://api.deepseek.com
# - Groq için:       https://api.groq.com/openai/v1
# - OpenRouter için: https://openrouter.ai/api/v1
# - Yerel Ollama:    http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Kullanmak istediğiniz Model Adı:
# - OpenAI:     gpt-4o-mini  veya  gpt-4o
# - DeepSeek:   deepseek-chat  veya  deepseek-reasoner
# - Groq:       llama-3.3-70b-versatile  veya  mixtral-8x7b-32768
# - Ollama:     llama3  veya  qwen2.5  veya  mistral
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# 3. ALTERNATİF SAĞLAYICILAR (GEMINI VEYA WATSONX)
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
